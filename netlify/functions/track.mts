import type{Config,Context}from'@netlify/functions';import{db}from'../../db/index.js';import{visitorEvents}from'../../db/schema.js';export default async(req:Request,_ctx:Context)=>{if(req.method!=='POST')return new Response('Method not allowed',{status:405});const body=await req.json();if(!body.sessionId||!body.eventType)return Response.json({error:'Ongeldig event'},{status:400});await db.insert(visitorEvents).values({sessionId:String(body.sessionId).slice(0,80),eventType:String(body.eventType).slice(0,40),path:String(body.path||'/').slice(0,300),productId:body.productId?Number(body.productId):null,referrer:body.referrer?String(body.referrer).slice(0,300):null,isActive:body.eventType!=='leave'});return Response.json({ok:true})};export const config:Config={path:'/api/track'}
